@baseUrl = http://localhost:3000
@productId = CAMBIAR_POR_ID_REAL

### Inicio
GET {{baseUrl}}/

### API info
GET {{baseUrl}}/api

### Products - obtener todos
GET {{baseUrl}}/api/products

### Products - obtener por ID
GET {{baseUrl}}/api/products/{{productId}}

### Products - crear
POST {{baseUrl}}/api/products
Content-Type: application/json

{
  "name": "Riñonera Trail Compact",
  "description": "Riñonera ligera para rutas cortas de senderismo.",
  "category": "Bolsas",
  "price": 19.99,
  "stock": 25,
  "capacity": "3L",
  "weight": "180 g",
  "material": "Poliéster resistente",
  "color": "Verde bosque",
  "image": "https://example.com/images/rinonera-trail-compact.jpg",
  "status": "available",
  "featured": false,
  "createdBy": "admin@geinomi.com"
}

### Products - actualizar
PUT {{baseUrl}}/api/products/{{productId}}
Content-Type: application/json

{
  "price": 21.99,
  "stock": 30,
  "featured": true
}

### Products - eliminar
DELETE {{baseUrl}}/api/products/{{productId}}

### Users
GET {{baseUrl}}/api/users

### Categories
GET {{baseUrl}}/api/categories

### Orders
GET {{baseUrl}}/api/orders

### Reviews
GET {{baseUrl}}/api/reviews

### Error 404
GET {{baseUrl}}/api/ruta-inexistente
